{
  "name": "musicmatch",
  "version": "2.0.0",
  "private": true,
  "description": "知音配对 — 学生 / 家长 与 音乐老师 的配对平台（Cloudflare Workers + D1）",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
